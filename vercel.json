{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/index", "destination": "/list.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/press", "destination": "/press.html" },
    { "source": "/hardstyle", "destination": "/hardstyle.html" },
    { "source": "/arc-london", "destination": "/arc-london.html" },
    { "source": "/lone-ones", "destination": "/lone-ones.html" },
    { "source": "/cyvist", "destination": "/cyvist.html" },
    { "source": "/mudmetal", "destination": "/mudmetal.html" },
    { "source": "/vlone", "destination": "/vlone.html" },
    { "source": "/artist-merchandising", "destination": "/artist-merchandising.html" }
  ],
  "headers": [
    {
      "source": "/collage/opt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/archive", "destination": "/index", "permanent": true },
    { "source": "/work", "destination": "/index", "permanent": true }
  ]
}
